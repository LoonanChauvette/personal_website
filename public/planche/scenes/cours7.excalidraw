top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "text-060-85b0e4", "type": "text", "x": 13376, "y": 1004.375, "width": 361.92, "height": 18.125, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-054-ee962b", "roundness": null, "seed": 1574963607, "version": 1, "versionNonce": 717440070, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "D.  La MDS ne s’applique qu’aux sons harmoniques", "originalText": "D.  La MDS ne s’applique qu’aux sons harmoniques", "fontSize": 14.5, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "embeddable-061-b61dce", "type": "embeddable", "x": 13802, "y": 796, "width": 340, "height": 360, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 0, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-054-ee962b", "roundness": null, "seed": 956887591, "version": 1, "versionNonce": 1415900354, "isDeleted": false, "boundElements": [], "updated": 1, "link": "https://loonanchauvette.com/q/ecran.html?integre=1&question=q27&banque=/q/banques/cours7.md", "locked": false}, {"id": "text-062-723284", "type": "text", "x": 13376, "y": 1170, "width": 118.56, "height": 11.875, "angle": 0, "strokeColor": "#767676", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-054-ee962b", "roundness": null, "seed": 838145799, "version": 1, "versionNonce": 1028162213, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "© Loonan Chauvette, 2026", "originalText": "© Loonan Chauvette, 2026", "fontSize": 9.5, "fontFamily": 6, "t