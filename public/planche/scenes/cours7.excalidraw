nNonce": 2078054027, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "name": "Sondage q27", "customData": {"slidesOrder": 16, "presenterNotes": "Entrée : lancer, puis fermer, puis révéler. Question q27 de la banque."}}, {"id": "text-055-9fab1b", "type": "text", "x": 13376, "y": 746, "width": 238.68, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-054-ee962b", "roundness": null, "seed": 368871838, "version": 1, "versionNonce": 618979930, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Sons non musicaux", "originalText": "Sons non musicaux", "fontSize": 27, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "text-056-3451ef", "type": "text", "x": 13376, "y": 808, "width": 353.6, "height": 63.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-054-ee962b", "roundness": null, "seed": 1471609726, "version": 1, "versionNonce": 1137122202, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Pourquoi les espaces timbraux classiques\ndécrivent-ils mal les sons non musicaux\n?", "originalText": "Pourquoi les espaces timbraux classiques\ndécrivent-ils mal les sons non musicaux\n?", "fontSize": 17, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "text-057-f50def", "type": "text", "x": 13376, "y": 889.75, "width": 339.3, "height": 36.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "ro