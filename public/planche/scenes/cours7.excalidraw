 "version": 1, "versionNonce": 265695473, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Pourquoi les méthodes classiques de\nmesure conviennent-elles mal au timbre ?", "originalText": "Pourquoi les méthodes classiques de\nmesure conviennent-elles mal au timbre ?", "fontSize": 17, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "text-008-cb19b4", "type": "text", "x": 1336, "y": 868.5, "width": 339.3, "height": 36.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-005-d61aa9", "roundness": null, "seed": 212984476, "version": 1, "versionNonce": 949539216, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A.  Il faut connaître à l’avance le paramètre\nacoustique à mesurer", "originalText": "A.  Il faut connaître à l’avance le paramètre\nacoustique à mesurer", "fontSize": 14.5, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "text-009-17d9af", "type": "text", "x": 1336, "y": 912.75, "width": 324.22, "height": 18.125, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-005-d61aa9", "roundness": null, "seed": 571981485, "version": 1, "versionNonce": 1243862422, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "B.  Elles ne mesurent pas la discrimination", "originalText": "B.  Elles ne mesurent pas la discrimination", "fontSize": 14.5, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "text-010-d