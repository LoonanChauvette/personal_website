---
interface Props {
  pdfFile: string;
}

const { pdfFile } = Astro.props;
---

<a
  href={`/${pdfFile}`}
  download
  class="pdf-button ghost-border px-3 py-1 text-label-md uppercase tracking-wide text-primary ink-bleed transition-all ml-3 inline-block align-middle"
  aria-label="Download PDF"
>
  <svg class="w-4 h-4 inline-block align-middle mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
  </svg><span class="inline-block align-middle">PDF</span>
</a>
