---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/cv', label: 'CV' },
  { href: '/publications', label: 'Publications' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-nav bg-surface/80 border-b border-surface-container-low">
  <nav class="max-w-7xl mx-auto px-6 py-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <!-- Name/Brand -->
      <a href="/" class="font-serif text-headline-md font-semibold text-on-surface hover:text-primary transition-colors">
        Loonan Chauvette
      </a>

      <!-- Navigation Links -->
      <ul class="flex w-full items-center justify-between gap-3 sm:w-auto sm:justify-start sm:gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`font-sans text-body-lg uppercase tracking-wide transition-colors ${
                currentPath === item.href || (currentPath.startsWith(item.href) && item.href !== '/')
                  ? 'text-primary font-semibold'
                  : 'text-on-surface hover:text-primary'
              }`}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="relative">
          <details>
            <summary
              class={`cursor-pointer list-none font-sans text-body-lg uppercase tracking-wide transition-colors [&::-webkit-details-marker]:hidden ${
                currentPath.startsWith('/demo/')
                  ? 'text-primary font-semibold'
                  : 'text-on-surface hover:text-primary'
              }`}
            >
              Demo
            </summary>
            <ul class="absolute right-0 mt-3 min-w-40 bg-surface-container-lowest py-2">
              <li>
                <a
                  href="/demo/splatter.html"
                  class="block whitespace-nowrap px-4 py-2 font-sans text-body-md normal-case tracking-normal text-on-surface hover:bg-primary-container hover:text-primary"
                >
                  Splatter
                </a>
              </li>
              <li>
                <a
                  href="/demo/beating.html"
                  class="block whitespace-nowrap px-4 py-2 font-sans text-body-md normal-case tracking-normal text-on-surface hover:bg-primary-container hover:text-primary"
                >
                  Battements et rugosité
                </a>
              </li>
              <li>
                <a
                  href="/demo/traveling-wave.html"
                  class="block whitespace-nowrap px-4 py-2 font-sans text-body-md normal-case tracking-normal text-on-surface hover:bg-primary-container hover:text-primary"
                >
                  Onde voyageuse cochléaire
                </a>
              </li>
            </ul>
          </details>
        </li>
      </ul>
    </div>
  </nav>
</header>
