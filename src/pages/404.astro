---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Page Not Found - Loonan Chauvette"
  description="The page you're looking for doesn't exist."
>
  <section class="py-20 bg-surface min-h-[60vh] flex items-center">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h1 class="font-serif text-display-lg text-on-surface mb-6">
        404
      </h1>
      <p class="font-sans text-title-lg text-on-surface-variant mb-8">
        Page Not Found
      </p>
      <p class="font-sans text-body-lg text-on-surface leading-relaxed mb-12">
        The page you're looking for doesn't exist or has been moved.
      </p>
      
      <!-- Navigation Links -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-8 py-4 bg-primary text-surface-container-lowest font-sans text-body-lg hover:bg-primary/90 transition-all shadow-whisper"
        >
          Go Home
        </a>
        <a 
          href="/publications" 
          class="inline-flex items-center justify-center px-8 py-4 bg-surface-container-low text-on-surface font-sans text-body-lg hover:bg-surface-container transition-all shadow-whisper"
        >
          View Publications
        </a>
        <a 
          href="/cv" 
          class="inline-flex items-center justify-center px-8 py-4 bg-surface-container-low text-on-surface font-sans text-body-lg hover:bg-surface-container transition-all shadow-whisper"
        >
          View CV
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
